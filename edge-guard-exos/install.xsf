# install.xsf - edge guard accessories (EXOS / Switch Engine): UPM profile, EMS log filter and
# UPM log target. It does NOT apply the policy to any port: that is done by hand (apply.txt).
# Prerequisites: edge_guard.pol and edge_guard.py already on the switch flash (README, Installation).
# Usage:  load script install.xsf      then verify (README, Verification) and save.
# Safe to re-run (e.g. after an update): it first removes any previous accessories. This is not
# optional: if the profile already exists, "create upm profile" fails and EXOS runs the profile
# body as live commands, including "load script edge_guard.py" (verified on EXOS-VM 32.6.3.126).
# The errors these delete commands print on a first install are expected.
#
# 0) Remove a previous installation (same commands as uninstall.xsf; the ports keep the policy)
disable log target upm edge_guard
delete log target upm edge_guard
delete log filter edge_f
delete upm profile edge_guard
# 1) UPM profile: extracts slot, port and rule from the ACL log line and calls the script.
create upm profile edge_guard
set var s $TCL(regsub -all {^.* from ([0-9]+):[0-9]+ .*$} ${EVENT.LOG_PARAM_0} {\1})
set var p $TCL(regsub -all {^.* from [0-9]+:([0-9]+) .*$} ${EVENT.LOG_PARAM_0} {\1})
set var r $TCL(regsub -all {^.* matches rule ([A-Za-z0-9_]+):.*$} ${EVENT.LOG_PARAM_0} {\1})
load script edge_guard.py $s $p $r
.
# 2) EMS filter: only the Kern.Info messages generated by the edge_* policy entries
create log filter edge_f
configure log filter edge_f add events kern.info match string "matches rule edge_"
# 3) UPM log target that triggers the profile
create log target upm edge_guard
configure log target upm edge_guard filter edge_f
enable log target upm edge_guard
# 4) Syntax check of the policy file (it is not applied to any port here)
check policy edge_guard
create log message edge_guard_install.xsf_done
