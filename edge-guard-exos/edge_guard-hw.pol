# edge_guard-hw.pol - EXPERIMENTAL VARIANT: specific SNAP-type signatures, no generic SNAP rule.
# DO NOT use it before checking on the real switch that 'snap-type' matches (README, Verification):
# on EXOS-VM it is accepted without error but never matches, and there is no proof on any platform.
#
# Edge guard for EXOS / Switch Engine: disable an access port when a protocol that only a switch sends arrives on it.
# No STP and no link-type edge required. One entry per protocol ('if match any' with different fields does not work in ACLs).
# Every entry logs -> EMS filter "matches rule edge_" -> UPM log target edge_guard -> profile -> edge_guard.py
# Install: load script install.xsf ; apply to ports by hand: see apply.txt (after editing the file: refresh policy edge_guard)
# 'mirror-cpu': no effect on EXOS-VM; the User Guide requires it to log fast-path traffic on hardware.

# IEEE STP / RSTP / MSTP: LLC 42 42 03 (version 00/02/03 inside the BPDU). VERIFIED (EXOS-VM).
entry edge_stp {
    if {
        destination-sap 0x42;
        source-sap 0x42;
    } then {
        deny;
        count edge_stp;
        log;
        mirror-cpu;
    }
}

# Cisco PVST+/RPVST+ (SNAP OUI 00:00:0C, type 0x010B). NOT VERIFIED (snap-type never matches on EXOS-VM).
entry edge_pvst {
    if {
        snap-type 0x010b;
    } then {
        deny;
        count edge_pvst;
        log;
        mirror-cpu;
    }
}

# Cisco VTP (SNAP type 0x2003). NOT VERIFIED.
entry edge_vtp {
    if {
        snap-type 0x2003;
    } then {
        deny;
        count edge_vtp;
        log;
        mirror-cpu;
    }
}

# Cisco DTP (SNAP type 0x2004). NOT VERIFIED.
entry edge_dtp {
    if {
        snap-type 0x2004;
    } then {
        deny;
        count edge_dtp;
        log;
        mirror-cpu;
    }
}

# Cisco PAgP (SNAP type 0x0104). NOT VERIFIED.
entry edge_pagp {
    if {
        snap-type 0x0104;
    } then {
        deny;
        count edge_pagp;
        log;
        mirror-cpu;
    }
}

# Cisco UDLD (SNAP type 0x0111). NOT VERIFIED.
entry edge_udld {
    if {
        snap-type 0x0111;
    } then {
        deny;
        count edge_udld;
        log;
        mirror-cpu;
    }
}

# Extreme EDP and what travels inside it (ELRP, EAPS, ESRP): SNAP OUI 00:E0:2B, type 0x00BB. NOT VERIFIED.
entry edge_edp {
    if {
        snap-type 0x00bb;
    } then {
        deny;
        count edge_edp;
        log;
        mirror-cpu;
    }
}

# VOSS/Fabric Engine SLPP (ethertype 0x8102). VERIFIED against a real Fabric Engine 9.4 (EXOS-VM).
entry edge_slpp {
    if {
        ethernet-type 0x8102;
    } then {
        deny;
        count edge_slpp;
        log;
        mirror-cpu;
    }
}
